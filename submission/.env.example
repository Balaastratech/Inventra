# Submission-owned config. Copy to submission/.env (git-ignored) and fill in.
# The provided starter .env.example (repo root) still controls DATABASE_PATH etc.
# This file only adds what the starter package doesn't cover: LLM provider
# choice, and email notifications with reply/link-based approval.

# --- LLM provider: "vertex", "gemini" (AI Studio key), or "openai". No Anthropic. ---
MODEL_PROVIDER=vertex

# Vertex AI: no API key. Auth is Application Default Credentials --
# `gcloud auth application-default login`, or point
# GOOGLE_APPLICATION_CREDENTIALS at a service-account file kept outside
# this repo. GCP_PROJECT_ID is an identifier, not a secret, but the two
# lines below still shouldn't be committed with someone else's real project.
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=us-central1
VERTEX_DEMAND_MODEL=gemini-2.5-flash-lite
VERTEX_STRATEGIST_MODEL=gemini-2.5-flash
VERTEX_POLICY_MODEL=gemini-2.5-flash

# Gemini AI Studio: plain API key, no GCP project/IAM needed to run this.
# Use this path if you don't have a GCP project set up -- get a free key
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEMAND_MODEL=gemini-3.5-flash-lite
GEMINI_STRATEGIST_MODEL=gemini-3.5-flash
GEMINI_POLICY_MODEL=gemini-3.5-flash

# OpenAI fallback (used only if MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_DEMAND_MODEL=gpt-4o-mini
OPENAI_STRATEGIST_MODEL=gpt-4o-mini
OPENAI_POLICY_MODEL=gpt-4o-mini

# --- Email notifications (Gmail SMTP + App Password, not your normal password) ---
# Create one at https://myaccount.google.com/apppasswords (needs 2FA enabled).
# Defaults to true in code (submission/config.py) so notifications work out
# of the box; set false here to run silently (e.g. no Gmail creds handy).
EMAIL_ENABLED=true
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_TO=you@gmail.com

# --- Vendor purchase-order email (Gap 8) ---
# Sends the PO itself to the vendor's contact_email on file, separate from
# the internal notifications above. Stays false until the sending domain's
# SPF/DKIM/DMARC is set up -- see submission/notifications/vendor_email.py.
VENDOR_EMAIL_ENABLED=false

# --- Reply/link-based approval server ---
# The approve/reject links in emails point at this local server. It must be
# running (submission/graph/approval_server.py, Phase 3) for links to work,
# and must be reachable from wherever you open the email.
APPROVAL_SERVER_HOST=127.0.0.1
APPROVAL_SERVER_PORT=8787
APPROVAL_BASE_URL=http://127.0.0.1:8787
# Random secret used to HMAC-sign approval tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_TOKEN_SECRET=

# --- Data freshness override (brief says 2h, policy.md says 2 days/48h) ---
# Project owner's call: policy.md is authoritative (see submission/config.py
# module docstring). Uncomment to run the literal 2-hour brief reading instead.
# DATA_FRESHNESS_HOURS=2
