  "agents": {
    "investigator": {
      "purpose": "determine whether sourcing is needed",
      "tools": [
        "get_product",
        "get_stock_position",
        "get_sales_velocity",
        "calculate_stock_risk"
      ],
      "statuses": [
        "NO_ACTION",
        "NEEDS_INFORMATION",
        "BLOCKED",
        "AT_RISK"
      ],
      "forward_status": "AT_RISK",
      "handoff_object": "StockRisk"
    },
    "sourcing": {
      "purpose": "find a grounded eligible vendor option",
      "tools": [
        "list_vendor_offers",
        "get_vendor_performance",
        "build_vendor_options",
        "recommend_vendor_option"
      ],
      "statuses": [
        "BLOCKED",
        "ELIGIBLE"
      ],
      "forward_status": "ELIGIBLE",
      "handoff_object": "VendorRecommendation"
    },
    "policy_proposal": {
      "purpose": "apply policy/budget guardrails and prepare proposal for human approval",
      "tools": [
        "get_budget_position",
        "get_policy_guidance",
        "draft_replenishment_proposal"
      ],
      "statuses": [
        "BLOCKED",
        "AWAITING_APPROVAL"
      ],
      "forward_status": "AWAITING_APPROVAL",
      "handoff_object": "ReplenishmentProposal"
    }
  },
  "business_rules": {
    "inventory_freshness_hours_max": 2,
    "available_units_formula": "on_hand - reserved + confirmed_inbound",
    "sales_windows_days": [
      7,
      30
    ],
    "target_cover_days_default": 14,
    "target_cover_days_range": [
      7,
      45
    ],
    "vendor_reliability_min": 0.9,
    "arrival_requirement": "before projected stockout for normal recommendation",
    "budget_requirement": "total proposed cost fits latest remaining monthly budget for normal progression",
    "approval": "named human approves exact proposal version/hash",
    "post_approval_revalidation": [
      "inventory",
      "offer validity",
      "proposal hash",
      "budget"
    ],
    "duplicate_safety": "idempotency key plus unique database constraint"
  },
  "write_boundary": {
    "agent_can_write_purchase": false,
    "write_node": "execute_purchase",
    "write_tool": "create_purchase_request",
    "prerequisites": [
      "human approval",
      "passing revalidation",
      "idempotency protection"
    ]
  },
  "terminal_business_outcomes": [
    "NO_ACTION",
    "NEEDS_INFORMATION",
    "BLOCKED",
    "PURCHASE_REQUEST_CREATED"
  ],
  "nonterminal_workflow_statuses": [
    "AT_RISK",
    "ELIGIBLE",
    "AWAITING_APPROVAL"
  ],
  "known_source_ambiguities": [
    "Case Flow labels Sourcing and Policy/Proposal as PLANNED, while later interface documents label them Built & tested.",
    "Invalid-model-output Scenario 6 implementation status is inconsistent across the supplied Case Flow and Technical Review.",
    "Technical Review uses both four terminal business states and wording about five terminal states; AWAITING_APPROVAL is treated in this pack as a nonterminal paused workflow status.",
    "Some PDF table right columns are physically clipped by the original browser-to-PDF export."
  ]
}